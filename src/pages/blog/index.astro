---
import PostList from "@/components/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<BaseLayout
  title="Writing"
  description="Writing on engineering, startups, and the tools I build."
  back={{ label: "Index", href: "/" }}
>
  <h1>Writing</h1>
  <PostList posts={posts} />
</BaseLayout>

<style>
  h1 {
    color: var(--strong);
    margin-bottom: 3rem;
  }
</style>
