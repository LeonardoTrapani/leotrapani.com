---
import { render } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatLongDate, getPostPaths, type Post } from "@/lib/posts";

export const getStaticPaths = getPostPaths;

type Props = {
  post: Post;
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/blog/${post.id}.png`}
  type="article"
  publishedAt={post.data.createdAt}
>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="muted">{post.data.description}</p>
      <time class="muted" datetime={post.data.createdAt.toISOString()}>
        {formatLongDate(post.data.createdAt)}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="back">
    <a href="/blog">← All writing</a>
  </p>
</BaseLayout>

<style>
  header {
    margin-bottom: 3rem;
  }

  time {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }

  h1 {
    color: var(--strong);
    text-wrap: balance;
  }

  .back {
    margin-top: 4rem;
  }

  .back a {
    color: var(--muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--strong);
  }

  .prose > :global(*) + :global(*) {
    margin-top: var(--space);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.75rem;
    color: var(--strong);
    font-weight: 600;
  }

  .prose :global(h3) {
    font-weight: 500;
  }

  .prose :global(:is(h2, h3) + *) {
    margin-top: 0.75rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    color: var(--strong);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1.08em;
    font-style: italic;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1em 0.3em;
    border-radius: 4px;
    background: var(--code-background);
  }

  .prose :global(pre) {
    margin-left: -1rem;
    margin-right: -1rem;
    padding: 1rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.925rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  @media (max-width: 640px) {
    .prose :global(pre) {
      margin-left: -1.5rem;
      margin-right: -1.5rem;
      border-radius: 0;
      padding: 1rem 1.5rem;
    }
  }
</style>
