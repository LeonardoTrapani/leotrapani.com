---
import EntryList from "@/components/EntryList.astro";
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BUILDING } from "@/data/building";
import { PROJECTS } from "@/data/projects";
import { SITE, SOCIAL_LINKS } from "@/data/site";
import { getPinnedPosts, getPost, postUrl } from "@/lib/posts";

const pinned = await getPinnedPosts();
// Linked only once the post is published, so production never points at a draft.
const dropoutPost = await getPost("dropout");
const writing = [
  ...pinned.map((post) => ({
    name: post.data.title,
    href: postUrl(post),
    description: post.data.summary,
  })),
  { name: "All writing", href: "/blog" },
];
---

<BaseLayout>
  <div class="intro">
    <p>
      <em>Building startups in Italy.</em> Founding engineer at{" "}
      <a href="https://datapizza.tech">Datapizza</a>, the biggest AI deployment
      company in Italy. In July we raised a €10M Series A to bring AI into
      Italian companies at scale.
    </p>
  </div>

  <div class="columns">
    <Section title="Building">
      <EntryList items={BUILDING} />
    </Section>
    <Section title="Projects">
      <EntryList items={PROJECTS} />
    </Section>
    <Section title="Writing">
      <EntryList items={writing} />
    </Section>
  </div>

  <Section title="Now" prominent>
    <div class="stack">
      <p>
        I{" "}
        {dropoutPost ? (
          <a href={postUrl(dropoutPost)}>dropped out</a>
        ) : (
          "dropped out"
        )}{" "}
        of Bocconi to work on this full time. Most of my days go into Dual at
        Datapizza: a platform for building agents and automations that are
        reliable, observable and actually deployable inside a company. I focus
        on strategic technical vision, implementation and team management.
      </p>
      <p>
        The long-term plan is to build startups in Italy, and it starts now at
        Datapizza, bringing AI into Italian companies and the wider market.
        Meanwhile I'm going deep into the Italian startup ecosystem, so I'm
        ready when it's my turn.
      </p>
      <p>
        On the side I ship open-source, as a self-confessed Effect nerd, and
        train MMA. Twenty years old, living in Milan.
      </p>
    </div>
  </Section>

  <Section title="Before" prominent>
    <p>
      From 2022 to 2025 I freelanced, taking products from zero to production
      for startups and small teams.
    </p>
  </Section>

  <Section title="Connect" prominent>
    <p>
      Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me
      on{" "}
      {SOCIAL_LINKS.map((link, index) => (
        <>
          <a href={link.href}>{link.label}</a>
          {index < SOCIAL_LINKS.length - 2
            ? ", "
            : index === SOCIAL_LINKS.length - 2
              ? " and "
              : "."}
        </>
      ))}
    </p>
  </Section>
</BaseLayout>

<style>
  .intro,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }

  .intro {
    margin-bottom: 4rem;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .columns > :global(section + section) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
