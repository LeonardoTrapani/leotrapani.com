---
import EntryList from "@/components/EntryList.astro";
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BUILDING } from "@/data/building";
import { PROJECTS } from "@/data/projects";
import { SITE, SOCIAL_LINKS } from "@/data/site";
import { getPinnedPosts, postUrl } from "@/lib/posts";

const pinned = await getPinnedPosts();
const writing = [
  ...pinned.map((post) => ({
    name: post.data.title,
    href: postUrl(post),
    description: post.data.summary,
  })),
  { name: "All writing", href: "/blog", description: "Everything, by year." },
];
---

<BaseLayout>
  <div class="intro">
    <p>
      <em>Technical founder and startup engineer.</em> Leading Dual at{" "}
      <a href="https://datapizza.tech">Datapizza</a>, an agent platform that
      brings AI into enterprises. I joined as employee #8.
    </p>
    <p>
      From 2022 to 2025 I also freelanced, taking products from zero to
      production for startups and small teams.
    </p>
  </div>

  <div class="columns">
    <Section title="Building">
      <EntryList items={BUILDING} />
    </Section>
    <Section title="Projects">
      <EntryList items={PROJECTS} />
    </Section>
    <Section title="Writing">
      <EntryList items={writing} />
    </Section>
  </div>

  <Section title="Now" prominent>
    <p>
      Studying Economics, Management and Computer Science at Bocconi, shipping
      open-source on the side, and training MMA. Twenty years old, living in
      Milan.
    </p>
  </Section>

  <Section title="Connect" prominent>
    <p>
      Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me
      on{" "}
      {SOCIAL_LINKS.map((link, index) => (
        <>
          <a href={link.href}>{link.label}</a>
          {index < SOCIAL_LINKS.length - 2
            ? ", "
            : index === SOCIAL_LINKS.length - 2
              ? " and "
              : "."}
        </>
      ))}{" "}
      My <a href={SITE.resumeUrl}>resume</a> is here.
    </p>
  </Section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space);
    margin-bottom: 4rem;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .columns > :global(section + section) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
