---
import EntryList from "@/components/EntryList.astro";
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BUILDING } from "@/data/building";
import { PROJECTS } from "@/data/projects";
import { SITE, SOCIAL_LINKS } from "@/data/site";
import { getPinnedPosts, postUrl } from "@/lib/posts";

const pinned = await getPinnedPosts();
const writing = [
  ...pinned.map((post) => ({
    name: post.data.title,
    href: postUrl(post),
    description: post.data.summary,
  })),
  { name: "All writing", href: "/blog" },
];
---

<BaseLayout>
  <div class="intro">
    <p>
      <em>Building startups in Italy.</em> Founding engineer at{" "}
      <a href="https://datapizza.tech">Datapizza</a>, where I lead Dual, our
      agent platform, on the technical side. We bring AI into Italian companies,
      and in July we raised a €10M Series A to do it at scale.
    </p>
    <p>
      From 2022 to 2025 I also freelanced, taking products from zero to
      production for startups and small teams.
    </p>
  </div>

  <div class="columns">
    <Section title="Building">
      <EntryList items={BUILDING} />
    </Section>
    <Section title="Projects">
      <EntryList items={PROJECTS} />
    </Section>
    <Section title="Writing">
      <EntryList items={writing} />
    </Section>
  </div>

  <Section title="Now" prominent>
    <div class="now">
      <p>
        I dropped out of Bocconi to work on this full time. Most of my days go
        into Dual: making agents reliable enough that real companies run them in
        production, not just in a demo.
      </p>
      <p>
        The long-term plan is to build startups here in Italy, and Datapizza is
        where I'm learning how. On the side I ship open-source and train MMA.
        Twenty years old, living in Milan.
      </p>
    </div>
  </Section>

  <Section title="Connect" prominent>
    <p>
      Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me
      on{" "}
      {SOCIAL_LINKS.map((link, index) => (
        <>
          <a href={link.href}>{link.label}</a>
          {index < SOCIAL_LINKS.length - 2
            ? ", "
            : index === SOCIAL_LINKS.length - 2
              ? " and "
              : "."}
        </>
      ))}
    </p>
  </Section>
</BaseLayout>

<style>
  .intro,
  .now {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }

  .intro {
    margin-bottom: 4rem;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .columns > :global(section + section) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
