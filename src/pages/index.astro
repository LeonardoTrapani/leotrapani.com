---
import EntryList from "@/components/EntryList.astro";
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BUILDING } from "@/data/building";
import { PROJECTS } from "@/data/projects";
import { SITE, SOCIAL_LINKS } from "@/data/site";
import { getPinnedPosts, getPost, postUrl } from "@/lib/posts";

const pinned = await getPinnedPosts();
// Linked only once the post is published, so production never points at a draft.
const dropoutPost = await getPost("dropout");
const TALK_URL = "https://www.youtube.com/watch?v=mQWsm7AVbCM";
const writing = [
  ...pinned.map((post) => ({
    name: post.data.title,
    href: postUrl(post),
    description: post.data.summary,
  })),
  { name: "All writing", href: "/blog" },
];
---

<BaseLayout>
  <div class="intro">
    <p>
      <em>Building startups in Italy.</em> 20 y/o founding engineer at{" "}
      <a href="https://datapizza.tech">Datapizza</a>, the biggest AI deployment
      company in Italy. We raised a €10M Series A to scale it across the
      country.
    </p>
    <p>
      I love software architecture, distributed systems and{" "}
      <a href="https://effect.website">Effect</a>.{" "}
      <a href={TALK_URL} class="video" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"></path>
        </svg>
        My talk at Effect Milan
      </a>
      .
    </p>
  </div>

  <div class="columns">
    <Section title="Building">
      <EntryList items={BUILDING} />
    </Section>
    <Section title="Projects">
      <EntryList items={PROJECTS} />
    </Section>
    <Section title="Writing">
      <EntryList items={writing} />
    </Section>
  </div>

  <Section title="Now" prominent>
    <div class="stack">
      <p>
        Working since I was 16, just{" "}
        {dropoutPost ? (
          <a href={postUrl(dropoutPost)}>dropped out</a>
        ) : (
          "dropped out"
        )}{" "}
        of Bocconi. Most of my days go into Dual, where I'm technical lead and
        own the technical strategy: a platform for agents and automations that
        are reliable, observable and actually deployable inside a company.
      </p>
      <p>On the side I ship open-source and train MMA. Based in Milan.</p>
    </div>
  </Section>

  <Section title="Connect" prominent>
    <p>
      Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me
      on{" "}
      {SOCIAL_LINKS.map((link, index) => (
        <>
          <a href={link.href}>{link.label}</a>
          {index < SOCIAL_LINKS.length - 2
            ? ", "
            : index === SOCIAL_LINKS.length - 2
              ? " and "
              : "."}
        </>
      ))}
    </p>
  </Section>
</BaseLayout>

<style>
  .intro,
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }

  .intro {
    margin-bottom: 4rem;
  }

  .video svg {
    width: 1em;
    height: 1em;
    margin-right: 0.375em;
    vertical-align: -0.125em;
    fill: var(--muted);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .columns > :global(section + section) {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
