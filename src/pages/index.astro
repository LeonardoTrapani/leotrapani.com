---
import PostList from "@/components/PostList.astro";
import Section from "@/components/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROJECTS } from "@/data/projects";
import { SITE, SOCIAL_LINKS } from "@/data/site";
import { WORK } from "@/data/work";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<BaseLayout>
  <div class="intro">
    <p>
      <em>Technical founder and startup engineer.</em> 20 years old, based in
      Milan.
    </p>
    <p>
      At <a href="https://datapizza.tech">Datapizza</a> (#8), I'm leading Dual,
      building an agent platform that brings AI into enterprises.
    </p>
    <p>
      Outside of work I ship and contribute to open-source projects, train MMA,
      and live my university life in Milan.
    </p>
  </div>

  <Section title="Work">
    <ul class="entries">
      {WORK.map((role) => (
        <li class="entry">
          <div>
            {role.href ? (
              <a href={role.href}>{role.organization}</a>
            ) : (
              <span>{role.organization}</span>
            )}
            <p class="muted">{role.title}</p>
          </div>
          <span class="muted period">
            {role.start}–{role.end ?? "now"}
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Projects">
    <ul class="entries">
      {PROJECTS.map((project) => (
        <li>
          <a href={project.href}>{project.name}</a>
          <p class="muted">{project.description}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Writing">
    <PostList posts={posts} />
  </Section>

  <Section title="Connect">
    <p>
      Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, or find me
      on{" "}
      {SOCIAL_LINKS.map((link, index) => (
        <>
          <a href={link.href}>{link.label}</a>
          {index < SOCIAL_LINKS.length - 2
            ? ", "
            : index === SOCIAL_LINKS.length - 2
              ? " and "
              : "."}
        </>
      ))}{" "}
      My <a href={SITE.resumeUrl}>resume</a> is here.
    </p>
  </Section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .period {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
