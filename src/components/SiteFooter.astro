---
import { SITE } from "@/data/site";

const year = new Date().getFullYear();
---

<footer>
  <span>
    {SITE.name}, {year}
  </span>
  <a href="/rss.xml">RSS</a>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 6rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--strong);
  }
</style>
