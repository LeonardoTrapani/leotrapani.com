---
import { getPost, postUrl } from "@/lib/posts";

// Linked only once the post is published, so production never points at a draft.
const dropoutPost = await getPost("dropped-out");
---

<div class="now">
  <p>
    Working since I was 16, just{" "}
    {dropoutPost ? (
      <a href={postUrl(dropoutPost)}>dropped out</a>
    ) : (
      "dropped out"
    )}{" "}
    of Bocconi. Most of my days go into Dual, a platform for agents and
    automations that are reliable, observable and actually deployable inside a
    company.
  </p>
  <p>On the side I ship open-source and train MMA. Based in Milan.</p>
</div>

<style>
  .now {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }
</style>
