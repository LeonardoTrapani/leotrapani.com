---
type Props = {
  title: string;
  prominent?: boolean;
};

const { title, prominent = false } = Astro.props;
const id = title.toLowerCase().replace(/\s+/g, "-");
---

<section aria-labelledby={id}>
  <h2 id={id} class={prominent ? "heading" : "label"}>
    {title}
  </h2>
  <slot />
</section>

<style>
  section + :global(section) {
    margin-top: 4rem;
  }

  .heading {
    color: var(--strong);
    margin-bottom: var(--space);
  }
</style>
