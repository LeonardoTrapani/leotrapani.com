---
import type { Entry } from "@/data/entry";

type Props = {
  items: Entry[];
  inline?: boolean;
};

const { items, inline = false } = Astro.props;
---

<ul class:list={{ inline }}>
  {items.map((item) => (
    <li>
      <a href={item.href}>{item.name}</a>
      {item.description && <p class="muted">{item.description}</p>}
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .inline {
    gap: 0.75rem;
  }

  .inline li {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
  }
</style>
