---
type Item = {
  name: string;
  href: string;
  description?: string;
};

type Props = {
  items: Item[];
};

const { items } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ul>
  {items.map((item) => (
    <li>
      <a href={item.href}>{item.name}</a>
      {isExternal(item.href) && (
        <svg
          class="arrow"
          aria-hidden="true"
          viewBox="0 0 16 16"
          width="14"
          height="14"
        >
          <path
            d="M5 11 11 5M6 5h5v5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )}
      {item.description && <p class="muted">{item.description}</p>}
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .arrow {
    margin-left: 0.25rem;
    color: var(--muted);
    vertical-align: -1px;
  }
</style>
