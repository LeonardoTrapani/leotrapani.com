---
import type { Entry } from "@/data/entry";

type Props = {
  items: Entry[];
};

const { items } = Astro.props;
---

<ul>
  {items.map((item) => (
    <li>
      <a href={item.href}>{item.name}</a>
      {item.description && <span class="muted">{item.description}</span>}
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
  }
</style>
