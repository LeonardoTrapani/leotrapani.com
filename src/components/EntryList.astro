---
import type { Entry } from "@/data/entry";

type Props = {
  items: Entry[];
};

const { items } = Astro.props;
---

<ul>
  {items.map((item) => (
    <li>
      <a href={item.href}>{item.name}</a>
      {item.description && <p class="muted">{item.description}</p>}
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
